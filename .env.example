# ───────────────────────────── AgriCarbon Atlas ─────────────────────────────
# Copy to .env (never commit .env). Every external endpoint is configurable.

# ---- Runtime --------------------------------------------------------------
ATLAS_ENV=development                 # development | production
ATLAS_MODE=demo                       # demo (offline, synthetic data) | live (public APIs)
ATLAS_LOG_LEVEL=info
ATLAS_API_HOST=0.0.0.0
ATLAS_API_PORT=8000
ATLAS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:8080
ATLAS_API_KEYS=                       # comma-separated; when set, X-API-Key is required on mutating endpoints
ATLAS_RATE_LIMIT=60/minute
ATLAS_MAX_PLOT_VERTICES=500
ATLAS_MAX_PLOT_AREA_HA=10000
ATLAS_ALLOW_PENDING_PARAMETERS=true   # production should set false (fails on unverified parameters)
ATLAS_MAX_BODY_BYTES=1000000          # JSON request limit
ATLAS_MAX_UPLOAD_MB=50                # Import data: GeoJSON / KML / KMZ / CSV / LAS / LAZ upload limit
ATLAS_SEED_DEMO=true                  # demo mode: create the three synthetic demo plots at start-up
ATLAS_RATE_LIMIT_ENABLED=true
ATLAS_CACHE_DIR=.cache
ATLAS_REPORTS_DIR=.reports

# ---- Storage --------------------------------------------------------------
ATLAS_REPOSITORY=memory               # memory | postgres (tables: data/schemas/schema.sql)
DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlas
# Object storage for your own PMTiles basemap is configured on the web side
# (VITE_BASEMAP_PMTILES_URL); the API itself does not use S3 in this release.

# ---- Earth observation ----------------------------------------------------
# STAC provider for Sentinel-2 L2A: earth-search (no auth, COGs on AWS) or copernicus
ATLAS_STAC_PROVIDER=earth-search
EARTH_SEARCH_STAC_URL=https://earth-search.aws.element84.com/v1
COPERNICUS_STAC_URL=https://stac.dataspace.copernicus.eu/v1
COPERNICUS_TOKEN=                     # only needed to download CDSE assets
ESA_WORLDCOVER_BASE_URL=https://esa-worldcover.s3.eu-central-1.amazonaws.com/v200/2021/map
ESA_WORLDCOVER_VERSION=v200
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_ELEVATION_URL=https://api.open-meteo.com/v1/elevation
SOILGRIDS_URL=https://rest.isric.org/soilgrids/v2.0/properties/query
MAX_CLOUD_COVER_PCT=20

# ---- Geocoding (respect provider usage policies) --------------------------
ATLAS_GEOCODER=nominatim              # nominatim | photon
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=agricarbon-atlas/0.1 (contact: you@example.org)   # REQUIRED by Nominatim policy
PHOTON_URL=https://photon.komoot.io
GEOCODER_MIN_INTERVAL_SECONDS=1.0

# ---- Regional statistics --------------------------------------------------
USDA_NASS_API_URL=https://quickstats.nass.usda.gov/api/api_GET/
USDA_NASS_API_KEY=                    # free key: https://quickstats.nass.usda.gov/api
CENSUS_GEOCODER_URL=https://geocoding.geo.census.gov/geocoder/geographies/coordinates
DATA_GOV_IN_API_URL=https://api.data.gov.in/resource
DATA_GOV_IN_API_KEY=                  # free key: https://data.gov.in
DATA_GOV_IN_CROP_RESOURCE_ID=35be999b-0208-4354-b557-f6ca9a5355de   # district-wise crop production; verify

# ---- Satellite imagery (map display) ---------------------------------------
# Providers, licences and attribution: config/imagery/providers.yaml.
# Esri World Imagery is display-only and needs an ArcGIS Location Platform key;
# use a referrer-restricted key — it is sent to the browser with the tile URL.
ESRI_API_KEY=

# ---- Agentic AI framework and explanations (privacy-preserving) -----------
# Agents are deterministic by default. With ATLAS_AGENT_REASONER=llm an
# OpenAI-compatible endpoint (e.g. a local Ollama: http://localhost:11434/v1)
# may only REPHRASE agent sentences from redacted facts — never numbers,
# never coordinates. The template text is kept whenever the LLM fails.
ATLAS_AGENT_REASONER=template         # template | llm
ATLAS_EXPLAIN_PROVIDER=template       # template | llm (opt-in; receives derived indicators only)
#
# Provider options (OpenAI-compatible; checked 2026-10-11 — see docs/agents/AGENTS_OVERVIEW.md):
#   Ollama (local, free, most private)  LLM_API_BASE_URL=http://localhost:11434/v1   LLM_MODEL=llama3.2   (no key)
#   Groq (free tier)                    LLM_API_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.1-8b-instant
#   Cloudflare Workers AI (free daily)  LLM_API_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1   LLM_MODEL=@cf/meta/llama-3.1-8b-instruct
#   OpenRouter (:free models)           LLM_API_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=<a :free model id>
#   xAI Grok (PAID — no free tier found) LLM_API_BASE_URL=https://api.x.ai/v1   LLM_MODEL=grok-4.20-0309-non-reasoning
#
# KEEP KEYS PRIVATE: this file is git-ignored and docker-ignored, so the real
# .env never leaves your computer. Never put a key in a VITE_* variable — those
# are built into the public web app. On Windows, API-KEYS.bat can store keys
# encrypted instead (DPAPI); a key saved there overrides the value here.
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20

# ---- Web app (Vite reads VITE_* at build time) -----------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_BASEMAP_STYLE_URL=https://demotiles.maplibre.org/style.json   # demo only; use your own PMTiles in production
VITE_BASEMAP_PMTILES_URL=            # e.g. https://<bucket>/basemap.pmtiles (Protomaps build, ODbL attribution required)
VITE_SATELLITE_TILES_URL=            # optional override for the Satellite view (XYZ template); otherwise the API's /imagery/providers is used
VITE_SATELLITE_ATTRIBUTION=
VITE_DEFAULT_COUNTRY=IN
VITE_DEFAULT_LANGUAGE=en
