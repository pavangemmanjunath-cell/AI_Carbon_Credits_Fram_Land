# syntax=docker/dockerfile:1.7
# AgriCarbon Atlas — web image (Vite build → nginx static server on :8080)
#
# Build:
#   docker build -f infra/docker/Dockerfile.web \
#     --build-arg VITE_API_BASE_URL=https://api.example.org/api/v1 \
#     --build-arg VITE_BASEMAP_PMTILES_URL=https://tiles.example.org/basemap.pmtiles \
#     -t agricarbon-atlas-web .
# Run:
#   docker run --rm -p 8080:8080 \
#     -e ATLAS_API_ORIGIN=https://api.example.org \
#     -e ATLAS_BASEMAP_ORIGINS="https://tiles.example.org" \
#     agricarbon-atlas-web
#
# VITE_* values are compiled into the bundle at build time (Vite semantics);
# the ATLAS_*_ORIGIN variables are read at container start to render the
# Content Security Policy in infra/docker/nginx.conf. Keep them consistent.

# ---------------------------------------------------------------- build stage
FROM node:22-alpine AS build

WORKDIR /app/apps/web

# Build-time configuration (see .env.example, "Web app" section).
ARG VITE_API_BASE_URL=http://localhost:8000/api/v1
ARG VITE_BASEMAP_STYLE_URL=https://demotiles.maplibre.org/style.json
ARG VITE_BASEMAP_PMTILES_URL=
ARG VITE_SATELLITE_TILES_URL=
ARG VITE_SATELLITE_ATTRIBUTION=
ARG VITE_DEFAULT_COUNTRY=IN
ARG VITE_DEFAULT_LANGUAGE=en

ENV VITE_API_BASE_URL=${VITE_API_BASE_URL} \
    VITE_BASEMAP_STYLE_URL=${VITE_BASEMAP_STYLE_URL} \
    VITE_BASEMAP_PMTILES_URL=${VITE_BASEMAP_PMTILES_URL} \
    VITE_SATELLITE_TILES_URL=${VITE_SATELLITE_TILES_URL} \
    VITE_SATELLITE_ATTRIBUTION=${VITE_SATELLITE_ATTRIBUTION} \
    VITE_DEFAULT_COUNTRY=${VITE_DEFAULT_COUNTRY} \
    VITE_DEFAULT_LANGUAGE=${VITE_DEFAULT_LANGUAGE} \
    NODE_ENV=production \
    CI=true

# Install with the lockfile only (reproducible, cached layer).
COPY apps/web/package.json apps/web/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm,sharing=locked \
    npm ci --include=dev --no-audit --no-fund

# Source and shared configuration the UI may import at build time.
COPY apps/web/ ./
COPY config/ /app/config/

RUN npm run build \
    && test -f dist/index.html

# -------------------------------------------------------------- runtime stage
FROM nginx:alpine AS runtime

LABEL org.opencontainers.image.title="AgriCarbon Atlas web" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.source="https://github.com/<org>/agricarbon-atlas"

# Runtime CSP inputs, rendered by the nginx image's envsubst entrypoint
# (templates in /etc/nginx/templates → /etc/nginx/conf.d). Space-separated
# origins are allowed in ATLAS_BASEMAP_ORIGINS and ATLAS_EXTRA_CONNECT_SRC.
ENV NGINX_PORT=8080 \
    ATLAS_API_ORIGIN=http://localhost:8000 \
    ATLAS_BASEMAP_ORIGINS="https://demotiles.maplibre.org" \
    ATLAS_EXTRA_CONNECT_SRC="https://basemap.nationalmap.gov https://data.geopf.fr https://www.ign.es https://service.pdok.nl https://tiles.maps.eox.at https://ibasemaps-api.arcgis.com" \
    ATLAS_EXTRA_IMG_SRC="https://basemap.nationalmap.gov https://data.geopf.fr https://www.ign.es https://service.pdok.nl https://tiles.maps.eox.at https://ibasemaps-api.arcgis.com"

RUN rm -f /etc/nginx/conf.d/default.conf \
    && mkdir -p /etc/nginx/templates

COPY infra/docker/nginx.conf /etc/nginx/templates/default.conf.template
COPY --from=build /app/apps/web/dist/ /usr/share/nginx/html/

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/healthz >/dev/null 2>&1 || exit 1

# nginx:alpine starts the master as root and drops workers to the `nginx`
# user. For a fully non-root container swap the base image for
# `nginxinc/nginx-unprivileged:alpine` (already listens on 8080; keep the
# template path unchanged).
CMD ["nginx", "-g", "daemon off;"]
